  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: CourtScene_MarcusClosing
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Chief Inspector Marcus
    text: Well done kid, I knew you could do it!
  - speaker: Player
    text: Thank you, chief. Couldn't have done it without your help.
  - speaker: Chief Inspector Marcus
    text: "Naah, you deserve all the credit! You don't need me guiding you anymore!"
  - speaker: Player
    text: Thank you, chief!
  - speaker: Chief Inspector Marcus
    text: "I'll be here for you when you need me, in the mean time off you go kid. Your next case awaits you."

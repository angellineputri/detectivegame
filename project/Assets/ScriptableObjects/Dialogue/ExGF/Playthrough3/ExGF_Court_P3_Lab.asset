  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: ExGF_Court_P3_Lab
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Police
    text: Yup, it checks out. He's the one.
    speakerPortrait: {fileID: 21300000, guid: 4a8657028dee24bd3ac29419c9169c7c, type: 3}
  - speaker: Police
    text: Fingerprints match. The bloody knife fingerprint also matches.
    speakerPortrait: {fileID: 21300000, guid: 4a8657028dee24bd3ac29419c9169c7c, type: 3}
  - speaker: You
    text: So he lied the whole time..
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Police
    text: Yeah... thanks for the journal though. The victim would've been happy knowing
      the truth finally came out because of his own work.
    speakerPortrait: {fileID: 21300000, guid: 4a8657028dee24bd3ac29419c9169c7c, type: 3}
  - speaker: You
    text: Yeah... too bad he's not here to see this.
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}

  lines:
  - speaker: Player
    text: wait is that.. chief?
    speakerPortrait: {fileID: 3425749645153845377, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Player
    text: hi chief, what are you doing here?
    speakerPortrait: {fileID: 3425749645153845377, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Chief
    text: hello kid, just finish up another case
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Chief
    text: will be on my way back now, how have you been
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Player
    text: wait, do you smoke?
    speakerPortrait: {fileID: 3425749645153845377, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Chief
    text: yeah, life gets.. hard
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}

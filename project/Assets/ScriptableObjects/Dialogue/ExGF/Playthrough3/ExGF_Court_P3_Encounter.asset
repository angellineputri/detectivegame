  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: ExGF_Court_P3_Encounter
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: You
    text: Wait, is that... chief?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: You
    text: Hi chief, what are you doing here?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Chief Inspector Marcus
    text: Hey kid, just finished up another case.
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: Chief Inspector Marcus
    text: About to head back now. How have you been?
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: You
    text: Wait, do you smoke?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Chief Inspector Marcus
    text: Yeah, life gets... hard.
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}

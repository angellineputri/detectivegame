  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: HeadChef_P2_PhoneCall
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Player
    text: Well hello there, sorry about it. I messed up.
    speakerPortrait: {fileID: 3425749645153845377, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Marco
    text: You still do. Please, trust me it's not us.
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Marco
    text: Argh I can't say anything here but I'll contact you again. Please, recheck
      his room, retrace his step.
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Marco
    text: Do anything...
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Marco
    text: Please it's not her...
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Marco
    text: I gotta go, people better not see us interact. You're our only hope..
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}

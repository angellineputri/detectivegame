MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: HeadChef_P2_PhoneCall
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: You
    text: Well hello there, sorry about it. I messed up.
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Head Chef Marco
    text: You still do. Please, trust me it's not us.
    speakerPortrait: {fileID: 21300000, guid: ab462b1b295b0465dad541ade8b6b05b, type: 3}
  - speaker: Head Chef Marco
    text: Argh I can't say anything here but I'll contact you again. Please, recheck
      his room, retrace his step.
    speakerPortrait: {fileID: 21300000, guid: ab462b1b295b0465dad541ade8b6b05b, type: 3}
  - speaker: Head Chef Marco
    text: Do anything...
    speakerPortrait: {fileID: 21300000, guid: ab462b1b295b0465dad541ade8b6b05b, type: 3}
  - speaker: Head Chef Marco
    text: Please it's not her...
    speakerPortrait: {fileID: 21300000, guid: ab462b1b295b0465dad541ade8b6b05b, type: 3}
  - speaker: Head Chef Marco
    text: I gotta go, people better not see us interact. You're our only hope..
    speakerPortrait: {fileID: 21300000, guid: ab462b1b295b0465dad541ade8b6b05b, type: 3}

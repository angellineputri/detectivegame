  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: Vivian_Bedroom_First
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Vivian Rose
    text: There's nothing here for you, detective.
    speakerPortrait: {fileID: 21300000, guid: b772191a5b62c4213af7d916d4de6f18, type: 3}
  - speaker: Vivian Rose
    text: I already told you everything at the diner.
    speakerPortrait: {fileID: 21300000, guid: b772191a5b62c4213af7d916d4de6f18, type: 3}
  - speaker: Vivian Rose
    text: It's late already, you should probably leave.
    speakerPortrait: {fileID: 21300000, guid: b772191a5b62c4213af7d916d4de6f18, type: 3}

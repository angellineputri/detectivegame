  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: CourtScene_MarcusClosing
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Chief Inspector Marcus
    text: Well done kid, I knew you could do it!
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: You
    text: Thank you, chief. Couldn't have done it without your help.
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Chief Inspector Marcus
    text: Nah, you deserve all the credit! You don't need me guiding you anymore!
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: You
    text: Thanks, chief!
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Chief Inspector Marcus
    text: I'll be here when you need me. Off you go, kid - your next case awaits!
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}

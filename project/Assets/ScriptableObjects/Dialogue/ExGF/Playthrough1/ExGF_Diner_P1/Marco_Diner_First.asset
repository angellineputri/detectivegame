%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: Marco_Diner_First
  m_EditorClassIdentifier: 
  lines:
  - speaker: Head Chef Marco
    text: Who are you and what's your business with Vivian?
    speakerPortrait: {fileID: 21300000, guid: ab462b1b295b0465dad541ade8b6b05b, type: 3}
  - speaker: You
    text: I'm the detective on this case, don't worry I'm just out here investigating.
      You run the kitchen here?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Head Chef Marco
    text: Since day one. She built this place, I made sure the food matched it. Gotta
      do her justice.
    speakerPortrait: {fileID: 21300000, guid: ab462b1b295b0465dad541ade8b6b05b, type: 3}
  - speaker: You
    text: Close with her, I assume?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Head Chef Marco
    text: Well someone's got to look out for her.
    speakerPortrait: {fileID: 21300000, guid: ab462b1b295b0465dad541ade8b6b05b, type: 3}
  - speaker: You
    text: Permission to further inspect the kitchen?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Head Chef Marco
    text: Follow me.
    speakerPortrait: {fileID: 21300000, guid: ab462b1b295b0465dad541ade8b6b05b, type: 3}

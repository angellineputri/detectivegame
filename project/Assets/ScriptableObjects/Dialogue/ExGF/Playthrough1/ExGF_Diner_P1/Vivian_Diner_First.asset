MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: Vivian_Diner_First
  m_EditorClassIdentifier: 
  lines:
  - speaker: You
    text: Vivian? I got a few questions about Julian.
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Vivian Rose
    text: Figured someone would come by. We broke up the night before he died, he
      has nothing to do with me anymore.
    speakerPortrait: {fileID: 21300000, guid: b772191a5b62c4213af7d916d4de6f18, type: 3}
  - speaker: You
    text: What happened?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Vivian Rose
    text: He said things were 'getting complicated'. Wouldn't explain. I didn't push
      it, should've though.
    speakerPortrait: {fileID: 21300000, guid: b772191a5b62c4213af7d916d4de6f18, type: 3}
  - speaker: You
    text: It's a busy afternoon. Where can I reach you if I have more questions?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Vivian Rose
    text: I live above the bakery two blocks from here. Door's always open for the
      police, I suppose. Stop by when I reach home, here's the full address.
    speakerPortrait: {fileID: 21300000, guid: b772191a5b62c4213af7d916d4de6f18, type: 3}

MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: VA_Chief_BothFound
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Chief Inspector Marcus
    text: Sharp eye, kid! Now, which one are you leaning towards suspecting?
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: Chief Inspector Marcus
    text: The professional assistant who knows the victim's every move, or...
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: Chief Inspector Marcus
    text: the ex-girlfriend he just broke up with the night before the accident...
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: Chief Inspector Marcus
    text: Think about it and make a move when you're ready!
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: Chief Inspector Marcus
    text: You know how to make a move, right...?
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: Chief Inspector Marcus
    text: Just open your bag, press make a move, and pick an object!
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: Chief Inspector Marcus
    text: Pretty simple, right? It's available anytime you're ready, kiddo!
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}

  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: VA_Chief_Opening
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Chief Inspector Marcus
    text: Congrats rookie, your first ever case! I brought you here to the victim's
      apartment. Press Enter or Space to continue.
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: Chief Inspector Marcus
    text: Try moving around with WASD and see what you can find!
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}

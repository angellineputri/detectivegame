  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: Vivian_Diner_First
  m_EditorClassIdentifier: 
  lines:
  - speaker: Player
    text: Ms. Vivian? I got a few questions about Julian.
    speakerPortrait: {fileID: 3425749645153845377, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Vivian
    text: Figured someone would come by. We broke up the night before he died, he
      has nothing to do with me anymore.
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Player
    text: What happened?
    speakerPortrait: {fileID: 3425749645153845377, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Vivian
    text: "He said things were \u2018getting complicated\u2019. Wouldn\u2019t explain.
      I didn\u2019t push it, should\u2019ve though."
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Player
    text: "Seems like it\u2019s a busy afternoon, where can I reach you if I have
      more questions?"
    speakerPortrait: {fileID: 3425749645153845377, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Vivian
    text: "I live above the bakery two blocks from here. Door\u2019s always open
      for the police, I suppose. Stop by when I reach home, here\u2019s the full
      address."
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}

  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: assistant_phone_npc_dialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: Player
    text: Before that night.. did the victim act weird?
    speakerPortrait: {fileID: 3425749645153845377, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Assistant
    text: Not that I noticed off.
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Player
    text: So theres nothing different at all?
    speakerPortrait: {fileID: 3425749645153845377, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Assistant
    text: Its really just like any other normal days, nothing weird at all
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}
  - speaker: Assistant
    text: We're just doing our usual routine, thats why everything really feels so
      sudden...
    speakerPortrait: {fileID: 3584525341705306422, guid: ac50471ca89a74434a48e415d7b77f9d,
      type: 3}

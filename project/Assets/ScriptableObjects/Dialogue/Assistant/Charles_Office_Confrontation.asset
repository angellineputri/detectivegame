  lines:
  - speaker: You
    text: Charles, care to explain this email?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Charles Isaac
    text: Wha... how did you.
    speakerPortrait: {fileID: 21300000, guid: 3c349057a58ca43e19e15f91ffe3cbfb, type: 3}
  - speaker: You
    text: Charles, you're under arrest for the murder of Julian Reyes.
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Charles Isaac
    text: Wait please I didn't have a choice...
    speakerPortrait: {fileID: 21300000, guid: 3c349057a58ca43e19e15f91ffe3cbfb, type: 3}

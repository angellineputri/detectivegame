MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: HeadOfIT_Office
  m_EditorClassIdentifier: 
  lines:
  - speaker: You
    text: Are you the head of the IT department?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Head of IT
    text: Who's asking?
    speakerPortrait: {fileID: 21300000, guid: 4bb2adc2ab29f4dc6bb99eae343a0ab6, type: 3}
  - speaker: You
    text: I'm the detective investigating the death of Julian Reyes.
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Head of IT
    text: I see... understood sir, how can I help?
    speakerPortrait: {fileID: 21300000, guid: 4bb2adc2ab29f4dc6bb99eae343a0ab6, type: 3}
  - speaker: You
    text: I need access to the assistant Charles's computer.
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Head of IT
    text: Very well, here you go.
    speakerPortrait: {fileID: 21300000, guid: 4bb2adc2ab29f4dc6bb99eae343a0ab6, type: 3}

  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: Charles_Phone_Dialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: You
    text: Before that night.. did the victim act weird?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Charles Isaac
    text: Not that I noticed.
    speakerPortrait: {fileID: 21300000, guid: 3c349057a58ca43e19e15f91ffe3cbfb, type: 3}
  - speaker: You
    text: So there's nothing different at all?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Charles Isaac
    text: It's really just like any other normal day, nothing weird at all.
    speakerPortrait: {fileID: 21300000, guid: 3c349057a58ca43e19e15f91ffe3cbfb, type: 3}
  - speaker: Charles Isaac
    text: We're just doing our usual routine, that's why everything really feels
      so sudden...
    speakerPortrait: {fileID: 21300000, guid: 3c349057a58ca43e19e15f91ffe3cbfb, type: 3}

  m_Script: {fileID: 11500000, guid: ce1d3326426d8413f86dce414ff780b1, type: 3}
  m_Name: ChiefInspector_Phone_KeyClosing
  m_EditorClassIdentifier: 
  lines:
  - speaker: Chief Inspector Marcus
    text: But there must be something wrong that causes the victim's means of firing
      him no?
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: Chief Inspector Marcus
    text: What do you think kid?
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
  - speaker: You
    text: There's two keys on the key ring, one labelled 'office'.
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: You
    text: I'll go to the office to look around. Their colleagues must know something,
      right?
    speakerPortrait: {fileID: 21300000, guid: 035e10dcc6ffb4506b2d69f521460b1b, type: 3}
  - speaker: Chief Inspector Marcus
    text: Smart kid.
    speakerPortrait: {fileID: 21300000, guid: 59d60445be5554d98850a2453f40d9ed, type: 3}
